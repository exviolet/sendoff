{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:scope-home-recursive",
    "fs:scope-desktop-recursive",
    "fs:scope-document-recursive",
    "fs:scope-download-recursive",
    "fs:scope-temp-recursive",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "tmux-list-panes",
          "cmd": "tmux",
          "args": ["list-panes", "-a", "-F", { "validator": "^[\\s\\S]*$" }]
        },
        {
          "name": "tmux-set-buffer",
          "cmd": "tmux",
          "args": ["set-buffer", "-b", "sendoff-desktop", "--", { "validator": "^[\\s\\S]*$" }]
        },
        {
          "name": "tmux-paste-buffer",
          "cmd": "tmux",
          "args": ["paste-buffer", "-d", "-p", "-b", "sendoff-desktop", "-t", { "validator": "^%[0-9]+$" }]
        },
        {
          "name": "tmux-send-enter",
          "cmd": "tmux",
          "args": ["send-keys", "-t", { "validator": "^%[0-9]+$" }, "Enter"]
        },
        {
          "name": "orca-terminal-send-text",
          "cmd": "orca-ide",
          "args": ["terminal", "send", "--terminal", { "validator": "^term_[0-9a-fA-F-]+$" }, "--text", { "validator": "^[\\s\\S]*$" }, "--json"]
        },
        {
          "name": "orca-terminal-send-enter",
          "cmd": "orca-ide",
          "args": ["terminal", "send", "--terminal", { "validator": "^term_[0-9a-fA-F-]+$" }, "--enter", "--json"]
        },
        {
          "name": "orca-worktree-ps",
          "cmd": "orca-ide",
          "args": ["worktree", "ps", "--json"]
        },
        {
          "name": "orca-terminal-list",
          "cmd": "orca-ide",
          "args": ["terminal", "list", "--json"]
        },
        {
          "name": "orca-terminal-wait",
          "cmd": "orca-ide",
          "args": ["terminal", "wait", "--terminal", { "validator": "^term_[0-9a-fA-F-]+$" }, "--for", "tui-idle", "--timeout-ms", { "validator": "^[0-9]+$" }, "--json"]
        },
        {
          "name": "herdr-agent-list",
          "cmd": "herdr",
          "args": ["agent", "list"]
        },
        {
          "name": "herdr-workspace-list",
          "cmd": "herdr",
          "args": ["workspace", "list"]
        },
        {
          "name": "herdr-tab-list",
          "cmd": "herdr",
          "args": ["tab", "list"]
        },
        {
          "name": "herdr-agent-prompt",
          "cmd": "herdr",
          "args": ["agent", "prompt", { "validator": "^w[A-Za-z0-9]+:p[A-Za-z0-9]+$" }, { "validator": "^[\\s\\S]*$" }]
        },
        {
          "name": "herdr-pane-send-text",
          "cmd": "herdr",
          "args": ["pane", "send-text", { "validator": "^w[A-Za-z0-9]+:p[A-Za-z0-9]+$" }, { "validator": "^[\\s\\S]*$" }]
        }
      ]
    },
    "allow-save-clipboard-image",
    "allow-locate-executables",
    "allow-webkit-version",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-theme"
  ]
}
